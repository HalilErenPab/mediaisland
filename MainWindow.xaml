<Window x:Class="MediaIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaIsland"
        Width="420" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Tasarım token'ları -->
        <SolidColorBrush x:Key="Ink" Color="#08080A"/>
        <SolidColorBrush x:Key="Rim" Color="#1C1C21"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E8E96"/>
        <SolidColorBrush x:Key="Track" Color="#2B2B31"/>
        <!-- Kapaktan çıkarılan renk; kod tarafında animasyonla değişir -->
        <SolidColorBrush x:Key="AccentBrush" Color="#E6E1D6"/>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="UtilityFont">Bahnschrift SemiCondensed, Segoe UI</FontFamily>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Halo" Fill="#FFFFFF" Opacity="0"/>
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.09"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Presenter" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Stroke" Value="{StaticResource TextPrimary}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <Style x:Key="EqBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="Margin" Value="1.25,0"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UtilityFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Sağ alta sabitlenir; genişlerken yukarı ve sola doğru büyür -->
        <Border x:Name="Island"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="104" Height="38" CornerRadius="19"
                Background="{StaticResource Ink}" BorderBrush="{StaticResource Rim}" BorderThickness="1"
                SizeChanged="Island_SizeChanged"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="MediaIsland'ı kapat" Click="Quit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid x:Name="IslandContent">
                <!-- Kapak: küçük hâlden büyük hâle aynı nesne olarak büyür; arkasından rengi taşar -->
                <Grid x:Name="CoverHost" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Width="26" Height="26" Margin="5,5,0,0" SizeChanged="CoverHost_SizeChanged">
                    <Ellipse x:Name="Glow" IsHitTestVisible="False" Opacity="0.18" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="3.2" ScaleY="3.2"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#E6E1D6"/>
                                <GradientStop Offset="1" Color="#00E6E1D6"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border x:Name="CoverBox" Background="{StaticResource Rim}" CornerRadius="6"/>
                </Grid>

                <!-- Ekolayzır: her iki hâlde de sağ üstte aynı yerde durur -->
                <StackPanel x:Name="Equalizer" Orientation="Horizontal" IsHitTestVisible="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Height="14" Margin="0,11,14,0">
                    <Rectangle Style="{StaticResource EqBar}" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle Style="{StaticResource EqBar}" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle Style="{StaticResource EqBar}" Fill="{StaticResource AccentBrush}"/>
                    <Rectangle Style="{StaticResource EqBar}" Fill="{StaticResource AccentBrush}"/>
                </StackPanel>

                <!-- Genişlemiş hâl -->
                <Grid x:Name="ExpandedPanel" Width="370" Height="170"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="93,15,48,0" Height="64" VerticalAlignment="Top">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SourceText" FontFamily="{StaticResource UtilityFont}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TitleText" Margin="0,1,0,0"
                                       FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15.5"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText"
                                       FontFamily="{StaticResource TextFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProgressRow" Margin="17,93,17,0" Height="16" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Style="{StaticResource TimeText}"/>
                        <Grid x:Name="SeekArea" Grid.Column="1" Background="Transparent"
                              MouseLeftButtonDown="Seek_MouseLeftButtonDown">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Track}" VerticalAlignment="Center"/>
                            <Border x:Name="ProgressFill" Width="0" Height="4" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Style="{StaticResource TimeText}" TextAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,114,0,0">
                        <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Click="Prev_Click" ToolTip="Önceki">
                            <Path Style="{StaticResource Glyph}" Data="M6,5 H8 V19 H6 Z M19,5 V19 L9,12 Z"/>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Click="PlayPause_Click"
                                Width="48" Height="48" Margin="18,0">
                            <Path x:Name="PlayGlyph" Style="{StaticResource Glyph}" Width="21" Height="21"
                                  Data="M8,5 L19,12 L8,19 Z"/>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Click="Next_Click" ToolTip="Sonraki">
                            <Path Style="{StaticResource Glyph}" Data="M16,5 H18 V19 H16 Z M5,5 V19 L15,12 Z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
